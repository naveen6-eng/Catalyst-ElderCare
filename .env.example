# Environment configuration template for CareCircle
# Database: PostgreSQL (Neon Serverless Postgres / Google Cloud SQL)
DATABASE_URL="postgresql://user:password@localhost:5432/carecircle?schema=public&sslmode=prefer"

# Application Session & Authentication
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-hex-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Email Notifications (Resend API)
RESEND_API_KEY="re_sample_test_key"
REMINDER_FROM_EMAIL="alerts@carecircle.app"

# Cron Webhook Protection for Google Cloud Scheduler
CRON_SECRET="sample-super-secret-cron-token"

# Port configuration (Google Cloud Run default is 8080)
PORT=3000
NODE_ENV="development"
